{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carlophillips.com/contracts/product-creation-job.schema.json",
  "title": "ProductCreationJob v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "jobId",
    "environment",
    "simulation",
    "entryMode",
    "releaseId",
    "candidateDisposition",
    "inputEvidence",
    "contractBindings",
    "truthPolicy",
    "approvals"
  ],
  "properties": {
    "schemaVersion": { "const": "cp.product-creation-job.v1" },
    "jobId": { "type": "string", "pattern": "^cp-[a-z0-9-]+$" },
    "environment": { "enum": ["local", "preview", "production"] },
    "simulation": { "type": "boolean" },
    "entryMode": { "enum": ["designer-led", "trend-led"] },
    "releaseId": { "type": "string", "pattern": "^cp-[a-z0-9-]+$" },
    "candidateDisposition": { "const": "draft-only" },
    "inputEvidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/inputEvidence" }
    },
    "contractBindings": {
      "type": "object",
      "required": ["productReleaseRecord", "mediaRegistry", "commerceGateway", "pipelineRunContract", "pipelineRunId"],
      "properties": {
        "productReleaseRecord": { "type": "string", "minLength": 1 },
        "mediaRegistry": { "type": "string", "minLength": 1 },
        "commerceGateway": { "const": "lib/commerce/product-gateway.js" },
        "pipelineRunContract": { "const": "contracts/pipeline-run.schema.json" },
        "pipelineRunId": { "type": "string", "pattern": "^cp-[a-z0-9-]+$" }
      },
      "additionalProperties": false
    },
    "truthPolicy": {
      "type": "object",
      "required": ["maySetProductTruth", "mayApproveMedia", "mayAuthorizeCommerce", "mayPublish"],
      "properties": {
        "maySetProductTruth": { "const": false },
        "mayApproveMedia": { "const": false },
        "mayAuthorizeCommerce": { "const": false },
        "mayPublish": { "const": false }
      },
      "additionalProperties": false
    },
    "approvals": {
      "type": "object",
      "required": ["externalExecution", "spend", "credits", "sample", "shopifyWrite", "publish", "production"],
      "properties": {
        "externalExecution": { "$ref": "#/$defs/approval" },
        "spend": { "$ref": "#/$defs/approval" },
        "credits": { "$ref": "#/$defs/approval" },
        "sample": { "$ref": "#/$defs/approval" },
        "shopifyWrite": { "$ref": "#/$defs/approval" },
        "publish": { "$ref": "#/$defs/approval" },
        "production": { "$ref": "#/$defs/approval" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "entryMode": { "const": "designer-led" } },
        "required": ["entryMode"]
      },
      "then": {
        "properties": {
          "inputEvidence": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": { "kind": { "const": "designer-brief" } },
              "required": ["kind"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "entryMode": { "const": "trend-led" } },
        "required": ["entryMode"]
      },
      "then": {
        "properties": {
          "inputEvidence": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": { "kind": { "const": "trend-signal" } },
              "required": ["kind"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "environment": { "enum": ["preview", "production"] } },
        "required": ["environment"]
      },
      "then": {
        "properties": {
          "inputEvidence": {
            "not": {
              "type": "array",
              "contains": {
                "type": "object",
                "properties": { "sourceType": { "const": "fixture" } },
                "required": ["sourceType"]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "inputEvidence": {
      "type": "object",
      "required": ["evidenceId", "kind", "sourceType", "sourceRef", "observedAt", "authority", "confidence"],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["brand-rule", "designer-brief", "reference", "trend-signal"] },
        "sourceType": { "enum": ["first-party", "research", "fixture"] },
        "sourceRef": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" },
        "authority": { "enum": ["candidate-input", "research-only"] },
        "confidence": { "enum": ["unassessed", "low", "medium", "high"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "trend-signal" } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "authority": { "const": "research-only" } }
          }
        },
        {
          "if": {
            "properties": { "sourceType": { "const": "fixture" } },
            "required": ["sourceType"]
          },
          "then": {
            "properties": {
              "authority": { "const": "research-only" },
              "confidence": { "const": "unassessed" }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": ["status", "owner"],
      "properties": {
        "status": { "const": "pending" },
        "owner": { "const": "Product Owner" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
