{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carlophillips.com/contracts/media-generation-workspace.schema.json",
  "title": "MediaGenerationWorkspace v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "workspaceId",
    "releaseId",
    "productHandle",
    "bindings",
    "rollout",
    "inputs",
    "constraintProfile",
    "providers",
    "workflow",
    "candidates"
  ],
  "properties": {
    "schemaVersion": { "const": "cp.media-generation-workspace.v1" },
    "workspaceId": { "type": "string", "minLength": 1 },
    "releaseId": { "type": "string", "minLength": 1 },
    "productHandle": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "bindings": {
      "type": "object",
      "required": ["mediaManifestFingerprint", "shopifyObservationFingerprint", "providerMappingFingerprint", "releaseEvidenceFingerprint"],
      "properties": {
        "mediaManifestFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "shopifyObservationFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "providerMappingFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "releaseEvidenceFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "rollout": {
      "type": "object",
      "required": ["flagName", "defaultEnabled", "mode", "productScoped", "rollback"],
      "properties": {
        "flagName": { "const": "CP_ADMIN_MEDIA_GENERATION_ENABLED" },
        "defaultEnabled": { "const": false },
        "mode": { "enum": ["shadow", "review", "active"] },
        "productScoped": { "const": true },
        "rollback": { "const": "disable-feature-flag" }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["inputId", "role", "reference", "fingerprint", "status"],
        "properties": {
          "inputId": { "type": "string", "minLength": 1 },
          "role": { "enum": ["factual-front", "garment-specification", "variants", "artwork-placement"] },
          "reference": { "type": "string", "minLength": 1 },
          "fingerprint": {
            "oneOf": [
              { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              { "type": "null" }
            ]
          },
          "status": { "enum": ["available", "partial", "missing"] }
        },
        "additionalProperties": false
      }
    },
    "constraintProfile": {
      "type": "object",
      "required": ["version", "status", "sourceInputIds", "checks"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "status": { "enum": ["incomplete", "ready", "failed"] },
        "sourceInputIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "checks": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "required": ["dimension", "status", "requirement"],
            "properties": {
              "dimension": { "enum": ["fabric", "weight", "fit", "construction", "colour", "decoration", "logo", "artwork-placement"] },
              "status": { "enum": ["known", "pending", "failed"] },
              "requirement": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["lane", "selected", "alternatives", "access", "costApproval"],
        "properties": {
          "lane": { "enum": ["fashion-imagery", "spin", "model-3d", "runway-motion"] },
          "selected": { "type": ["string", "null"] },
          "alternatives": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "access": { "enum": ["unconfigured", "evidence-only", "ready"] },
          "costApproval": { "enum": ["required", "approved", "not-applicable"] }
        },
        "additionalProperties": false
      }
    },
    "workflow": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": ["stage", "status", "authority"],
        "properties": {
          "stage": { "enum": ["ingest", "validate", "generate-reference-pack", "generate-media", "qa", "human-approval", "registry-proposal", "preview", "release"] },
          "status": { "enum": ["available", "partial", "blocked", "pending", "complete"] },
          "authority": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assetId",
          "label",
          "kind",
          "role",
          "truthClassification",
          "sourceReference",
          "checksum",
          "storageState",
          "qaStatus",
          "approvalStatus",
          "placement",
          "storefrontBound"
        ],
        "properties": {
          "assetId": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["image", "video", "spin", "model-3d"] },
          "role": { "enum": ["front", "back", "side", "three-quarter", "detail", "runway-motion", "fit-silhouette", "spin-360", "model-3d"] },
          "truthClassification": { "enum": ["factual-pod", "ai-assisted-product-visual", "ai-editorial", "ai-assisted-360", "approximate-3d", "physically-verified"] },
          "sourceReference": { "type": "string", "minLength": 1 },
          "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "storageState": { "enum": ["local-evidence", "private-draft", "quarantined", "approved-preview", "shopify-bound"] },
          "qaStatus": { "enum": ["pending", "partial", "failed", "passed"] },
          "approvalStatus": { "enum": ["pending", "approved", "rejected", "quarantined"] },
          "placement": { "enum": ["unassigned", "landing-editorial", "explore-media"] },
          "storefrontBound": { "const": false },
          "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
