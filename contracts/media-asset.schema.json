{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carlophillips.com/contracts/media-asset.schema.json",
  "title": "ProductMediaAsset v1",
  "type": "object",
  "required": ["schemaVersion", "assetId", "kind", "source", "storefrontBinding", "exactProductMatch", "rightsStatus", "approvalStatus", "quality", "alt"],
  "properties": {
    "schemaVersion": { "const": "cp.product-media-asset.v1" },
    "assetId": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["image", "video", "external_video", "model_3d", "spin"] },
    "source": {
      "type": "object",
      "required": ["type", "reference"],
      "properties": {
        "type": { "enum": ["pod-original", "shopify", "photography", "derived", "generated", "unknown"] },
        "reference": { "type": "string", "minLength": 1 },
        "method": { "type": "string" }
      },
      "additionalProperties": false
    },
    "storefrontBinding": {
      "oneOf": [
        {
          "type": "object",
          "required": ["adapter", "referenceHash", "evidence"],
          "properties": {
            "adapter": { "const": "shopify-storefront-media" },
            "referenceHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "evidence": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "exactProductMatch": { "enum": ["verified", "partial", "unverified", "not-applicable"] },
    "rightsStatus": { "enum": ["verified", "pending", "unknown"] },
    "approvalStatus": { "enum": ["pending", "approved", "rejected", "quarantined"] },
    "quality": {
      "type": "object",
      "required": ["status", "evidence"],
      "properties": {
        "status": { "enum": ["pending", "verified", "failed"] },
        "evidence": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "verified" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "evidence": { "type": "string", "minLength": 1 } }
          }
        }
      ],
      "additionalProperties": false
    },
    "alt": { "type": "string", "minLength": 1 },
    "fallbackAssetId": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
