{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carlophillips.com/contracts/capability-registry.schema.json",
  "title": "CapabilityRegistry v1",
  "type": "object",
  "required": ["schemaVersion", "observedAt", "source", "canonicalOwners", "capabilities"],
  "properties": {
    "schemaVersion": { "const": "cp.capability-registry.v1" },
    "observedAt": { "type": "string", "format": "date" },
    "source": { "type": "string", "minLength": 1 },
    "canonicalOwners": { "type": "object", "minProperties": 4 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["capability", "selectedAdapter", "accessState", "callableSurface", "allowedOperations", "requiresApproval", "costGate", "draftSafety", "alternatives", "blocker"],
        "properties": {
          "capability": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "selectedAdapter": { "type": ["string", "null"] },
          "accessState": { "enum": ["local_verified", "read_only_verified", "write_test_verified", "unverified", "human_required", "unavailable"] },
          "callableSurface": { "enum": ["local", "shopify_storefront", "shopify_admin", "shopify_flow", "app_api", "authenticated_browser", "human_only", "unverified", "unavailable"] },
          "evidenceRef": { "type": ["string", "null"], "minLength": 1 },
          "allowedOperations": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
          "requiresApproval": { "type": "array", "uniqueItems": true, "items": { "enum": ["spend", "credits", "sample", "publish", "production", "identity", "privacy", "payment", "order", "refund", "connector"] } },
          "costGate": { "type": "string", "minLength": 1 },
          "draftSafety": { "type": "string", "minLength": 1 },
          "alternatives": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "blocker": {
            "type": ["object", "null"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "humanAction": { "type": "string", "minLength": 1 },
              "resumePoint": { "type": "string", "minLength": 1 }
            },
            "required": ["code", "humanAction", "resumePoint"],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
