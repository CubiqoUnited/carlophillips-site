{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carlophillips.com/contracts/home-catalog-summary.schema.json",
  "title": "HomeCatalogSummary v1",
  "$defs": {
    "releaseBoundMedia": {
      "type": "object",
      "required": [
        "id",
        "registryAssetId",
        "approvalStatus",
        "sourceAuthority",
        "type",
        "url",
        "previewUrl",
        "alt",
        "label",
        "modalities"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "registryAssetId": { "type": "string", "minLength": 1 },
        "approvalStatus": { "const": "approved" },
        "sourceAuthority": { "const": "product-release-media-registry" },
        "type": {
          "enum": ["image", "video", "external_video", "model_3d", "spin"]
        },
        "url": { "type": "string", "minLength": 1 },
        "previewUrl": { "type": "string", "minLength": 1 },
        "alt": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "modalities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "front",
              "back-angle",
              "embroidery-detail",
              "material-detail",
              "on-model",
              "lifestyle",
              "spin-360",
              "model-3d-ar",
              "video"
            ]
          }
        },
        "onBodyPose": {
          "enum": ["front", "three-quarter", "profile", "seated", "back"]
        },
        "constructionDetail": {
          "enum": ["hood", "pocket", "seams", "cuffs", "waistband", "branding"]
        },
        "motionRole": { "enum": ["film", "preview"] }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schemaVersion",
    "environment",
    "status",
    "candidateCount",
    "visibleCount",
    "excludedCount",
    "commerceAllowed",
    "message",
    "primaryProduct"
  ],
  "properties": {
    "schemaVersion": { "const": "cp.home-catalog-summary.v1" },
    "environment": { "enum": ["local", "preview", "production"] },
    "status": { "enum": ["available", "unavailable", "denied"] },
    "candidateCount": { "type": "integer", "minimum": 0 },
    "visibleCount": { "type": "integer", "minimum": 0 },
    "excludedCount": { "type": "integer", "minimum": 0 },
    "commerceAllowed": { "type": "boolean" },
    "message": { "type": "string", "minLength": 1 },
    "primaryProduct": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": [
            "title",
            "href",
            "sourceLabel",
            "commerceAllowed",
            "description",
            "heroMedia",
            "media"
          ],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "href": {
              "type": "string",
              "pattern": "^/product/[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "sourceLabel": { "type": "string", "minLength": 1 },
            "commerceAllowed": { "type": "boolean" },
            "description": { "type": "string" },
            "handle": { "type": "string" },
            "price": { "type": "number" },
            "currency": { "type": "string" },
            "variantPresentation": { "type": ["object", "null"] },
            "offeredVariants": { "type": "array" },
            "variants": { "type": "array" },
            "heroMedia": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/releaseBoundMedia" }
              ]
            },
            "media": {
              "type": "array",
              "items": { "$ref": "#/$defs/releaseBoundMedia" }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "visibleCount": { "const": 0 } },
        "required": ["visibleCount"]
      },
      "then": { "properties": { "primaryProduct": { "type": "null" } } }
    },
    {
      "if": {
        "properties": { "visibleCount": { "minimum": 1 } },
        "required": ["visibleCount"]
      },
      "then": { "properties": { "primaryProduct": { "type": "object" } } }
    }
  ],
  "additionalProperties": false
}
