{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carlophillips.com/contracts/home-catalog-summary.schema.json",
  "title": "HomeCatalogSummary v1",
  "type": "object",
  "required": ["schemaVersion", "environment", "status", "candidateCount", "visibleCount", "excludedCount", "commerceAllowed", "message", "primaryProduct"],
  "properties": {
    "schemaVersion": { "const": "cp.home-catalog-summary.v1" },
    "environment": { "enum": ["local", "preview", "production"] },
    "status": { "enum": ["available", "unavailable", "denied"] },
    "candidateCount": { "type": "integer", "minimum": 0 },
    "visibleCount": { "type": "integer", "minimum": 0 },
    "excludedCount": { "type": "integer", "minimum": 0 },
    "commerceAllowed": { "const": false },
    "message": { "type": "string", "minLength": 1 },
    "primaryProduct": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["title", "href", "sourceLabel", "commerceAllowed"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "href": { "type": "string", "pattern": "^/products/[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "sourceLabel": { "type": "string", "minLength": 1 },
            "commerceAllowed": { "const": false }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "visibleCount": { "const": 0 } }, "required": ["visibleCount"] },
      "then": { "properties": { "primaryProduct": { "type": "null" } } }
    },
    {
      "if": { "properties": { "visibleCount": { "minimum": 1 } }, "required": ["visibleCount"] },
      "then": { "properties": { "primaryProduct": { "type": "object" } } }
    }
  ],
  "additionalProperties": false
}
