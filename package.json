{
  "name": "carlophillips-site",
  "version": "1.2.2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @repo/web dev",
    "dev:no-reload": "yarn workspace @repo/web dev",
    "dev:webpack": "yarn workspace @repo/web dev",
    "build": "yarn workspace @repo/web build",
    "start": "yarn workspace @repo/web start",
    "lint": "yarn lint:design-system && yarn lint:production-commerce && eslint . --max-warnings=0",
    "lint:design-system": "node scripts/lint-design-system.mjs",
    "lint:production-commerce": "node scripts/lint-production-commerce.mjs",
    "typecheck": "tsc --noEmit",
    "stylelint": "stylelint 'packages/design-system/styles/**/*.css'",
    "format:check": "prettier --check 'apps/**/*.{js,jsx,json,md,ts,tsx}' 'packages/**/*.{js,jsx,json,md,ts,tsx,css}' 'tests/**/*.{js,jsx,json,ts,tsx}' '.github/**/*.yml' '.lintstagedrc.json' '.eslintrc.cjs' '.prettierrc.cjs' '.stylelintrc.cjs' 'commitlint.config.cjs' 'tsconfig.json' 'turbo.json' 'vitest.config.ts'",
    "storybook": "yarn workspace @repo/design-system storybook",
    "build-storybook": "yarn workspace @repo/design-system build-storybook",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test tests/e2e",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "mock-assets": "node tools/mock-asset-factory.mjs",
    "mock-assets:ui": "node tools/mock-asset-factory-server.mjs",
    "audit:prod": "yarn audit --groups dependencies --level moderate",
    "verify:media-readiness": "node scripts/verify-media-readiness.mjs",
    "verify:vercel-link": "node scripts/verify-vercel-link.mjs",
    "verify": "yarn lint && yarn typecheck && yarn stylelint && yarn format:check && yarn verify:media-readiness && yarn test && yarn build-storybook && yarn audit:prod && yarn build",
    "prepare": "husky"
  },
  "dependencies": {
    "@clerk/nextjs": "7.7.5",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "lucide-react": "^0.516.0",
    "next": "15.5.21",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@napi-rs/canvas": "^1.0.8",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "20.19.24",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.19",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.21",
    "globals": "^16.2.0",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "pdfjs-dist": "3.11.174",
    "pdfreader": "^3.0.8",
    "playwright": "1.55.0",
    "postcss": "8.5.25",
    "prettier": "3.9.6",
    "stylelint": "16.23.1",
    "stylelint-config-standard": "38.0.0",
    "tailwindcss": "^3.4.1",
    "turbo": "2.10.10",
    "typescript": "5.9.3",
    "vitest": "^2.1.9"
  },
  "resolutions": {
    "lodash": "4.18.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
