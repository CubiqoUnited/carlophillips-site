{
    "name": "carlophillips-site",
    "version": "1.2.2",
    "private": true,
    "scripts": {
        "dev": "NODE_OPTIONS='--max-old-space-size=512' next dev --hostname 0.0.0.0 --port 3000",
        "dev:no-reload": "next dev --hostname 0.0.0.0 --port 3000",
        "dev:webpack": "next dev --hostname 0.0.0.0 --port 3000",
        "build": "next build",
        "start": "next start",
        "lint": "eslint . --max-warnings=0",
        "test": "vitest run",
        "test:a11y": "node scripts/accessibility-audit.mjs",
        "test:watch": "vitest",
        "audit:prod": "yarn audit --groups dependencies --level moderate",
        "verify:vercel-link": "node scripts/verify-vercel-link.mjs",
        "verify": "yarn lint && yarn test && yarn audit:prod && yarn build"
    },
    "dependencies": {
        "@clerk/nextjs": "7.7.5",
        "lucide-react": "^0.516.0",
        "next": "15.5.21",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "server-only": "^0.0.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.10.2",
        "ajv": "^8.17.1",
        "ajv-formats": "^3.0.1",
        "autoprefixer": "^10.4.19",
        "eslint": "8.57.1",
        "eslint-config-next": "15.5.21",
        "globals": "^16.2.0",
        "playwright": "1.55.0",
        "postcss": "8.5.25",
        "typescript": "5.9.3",
        "vitest": "^2.1.9"
    },
    "resolutions": {
        "lodash": "4.18.1",
        "nanoid": "3.3.18",
        "postcss": "8.5.25",
        "sharp": "0.35.3"
    },
    "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
