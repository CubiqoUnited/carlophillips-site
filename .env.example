# Local URL. Change this for a preview or production environment.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Local presentation controls. Preview and Production workflows force products on.
NEXT_PUBLIC_COMMERCE_ENVIRONMENT=local
NEXT_PUBLIC_SHOW_PRODUCTS=false
NEXT_PUBLIC_PREVIEW_DRAFT_PRODUCTS=false

# Server-only source selection. Fixtures are accepted only with local environment.
COMMERCE_DATA_MODE=fixture

# Shopify Storefront API. Server-only names are preferred for the new gateway.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=your-storefront-token
SHOPIFY_CHECKOUT_HOSTS=www.carlophillips.com

# Vercel Preview only: an isolated Shopify development store with test payments.
# Never point these variables at the Production store and never enable test mode
# on Production.
# Required Preview-only values. Preview never falls back to Production names.
SHOPIFY_STAGING_STORE_DOMAIN=your-test-store.myshopify.com
SHOPIFY_STAGING_STOREFRONT_TOKEN=your-test-storefront-token
# Use this server-only private token when a Shopify development store locks its
# public Online Store channel. Preview prefers it; Production never reads it.
SHOPIFY_STAGING_STOREFRONT_PRIVATE_TOKEN=your-test-storefront-private-token
SHOPIFY_STAGING_CHECKOUT_HOSTS=your-test-store.myshopify.com

# Server-only contact delivery. Configure only after a monitored recipient and
# sending identity are approved; never commit real values.
RESEND_API_KEY=your-resend-api-key
SHOPIFY_WEBHOOK_SECRET=replace-with-production-webhook-secret
# Optional Preview-only override; otherwise Preview uses its environment-scoped
# SHOPIFY_WEBHOOK_SECRET.
SHOPIFY_STAGING_WEBHOOK_SECRET=replace-with-staging-webhook-secret
# Exactly one environment-owned shop is allowed in each deployment.
SHOPIFY_WEBHOOK_ALLOWED_SHOPS=your-environment-store.myshopify.com
UPSTASH_REDIS_REST_URL=https://replace-with-upstash-rest-url
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# Non-secret isolation receipts. The two expected IDs must be different.
CP_COMMERCE_ENVIRONMENT=local
CP_DURABLE_STORE_ID=replace-with-current-environment-store-id
CP_EXPECTED_PREVIEW_DURABLE_STORE_ID=replace-with-preview-store-id
CP_EXPECTED_PRODUCTION_DURABLE_STORE_ID=replace-with-production-store-id

# CARLOPHILLIPS is continuously purchasable. Non-local runtimes require both.
SHOPIFY_CART_UI_ENABLED=true
SHOPIFY_CHECKOUT_ENABLED=true

# Optional public Shopify-owned post-purchase destinations. When absent or
# invalid, Aftercare fails closed and directs the customer to CP support or the
# secure order-status link in Shopify's notification email. Never place secrets
# or customer-specific order-status URLs here.
NEXT_PUBLIC_SHOPIFY_ACCOUNT_URL=
NEXT_PUBLIC_SHOPIFY_RETURNS_URL=
NEXT_PUBLIC_SHOPIFY_REVIEW_URL=
NEXT_PUBLIC_SHOPIFY_CREDIT_ENABLED=false

# Optional browser analytics.
NEXT_PUBLIC_VERCEL_OBSERVABILITY_ENABLED=false
NEXT_PUBLIC_ANALYTICS_APPROVED=false
# Legal/content owner gate. Draft policy routes remain noindex until approved.
NEXT_PUBLIC_POLICY_CONTENT_APPROVED=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Exact comma-separated HTTP(S) origins allowed to call /api cross-origin.
# Same-origin requests work without this value. Wildcards and URL paths are rejected.
CORS_ORIGINS=
# Local-only admin review. Never prefix these variables with NEXT_PUBLIC.
# CP_ADMIN_REVIEW_ENABLED=false
# CP_ADMIN_REVIEW_TOKEN=generate-a-random-token-with-at-least-32-characters
# A distinct credential is required for Product Owner-only Theme read/write.
# CP_ADMIN_PRODUCT_OWNER_TOKEN=generate-a-different-random-token-with-at-least-32-characters
# Theme saves remain disabled unless explicitly enabled and running on a local codex/* branch.
# CP_ADMIN_THEME_WRITES_ENABLED=false
# Product Owner-only, Draft media-generation review workspace. Keep false in
# Production; the server also hard-denies it on Production surfaces.
# CP_ADMIN_MEDIA_GENERATION_ENABLED=false

# Remote Product Owner sign-in. Vercel remains fail-closed unless all three
# names are configured by the approved Clerk project integration. Never commit values.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# CP_ADMIN_PRODUCT_OWNER_USER_ID=user_immutable_clerk_subject
