# Local URL. Change this for a preview or production environment.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Product release gates. Both must be true to show the static draft POC.
NEXT_PUBLIC_COMMERCE_ENVIRONMENT=local
NEXT_PUBLIC_SHOW_PRODUCTS=false
NEXT_PUBLIC_PREVIEW_DRAFT_PRODUCTS=false

# Shopify Storefront API. Keep placeholders here; use .env.local for values.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your-storefront-token

# Optional browser analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Restrict cross-origin API access per environment.
CORS_ORIGINS=http://localhost:3000
