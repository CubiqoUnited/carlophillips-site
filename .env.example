# Local URL. Change this for a preview or production environment.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Product release gates. Both must be true to show the static draft POC.
NEXT_PUBLIC_COMMERCE_ENVIRONMENT=local
NEXT_PUBLIC_SHOW_PRODUCTS=false
NEXT_PUBLIC_PREVIEW_DRAFT_PRODUCTS=false

# For private staging preview of draft media-only PDP review (non-commerce), set:
# NEXT_PUBLIC_COMMERCE_ENVIRONMENT=preview
# NEXT_PUBLIC_SHOW_PRODUCTS=true
# NEXT_PUBLIC_PREVIEW_DRAFT_PRODUCTS=true

# Server-only source selection.
# For private staging review without live Shopify dependency, use:
# COMMERCE_DATA_MODE=fixture
# For live Shopify observation/release review, remove this override.
COMMERCE_DATA_MODE=fixture

# Shopify Storefront API. Server-only names are preferred for the new gateway.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=your-storefront-token

# Customer cart UI remains off until the release, capability, variant, and
# Product Owner approval contract passes. This flag alone grants no authority.
SHOPIFY_CART_UI_ENABLED=false

# Optional browser analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Exact comma-separated HTTP(S) origins allowed to call /api cross-origin.
# Same-origin requests work without this value. Wildcards and URL paths are rejected.
CORS_ORIGINS=
